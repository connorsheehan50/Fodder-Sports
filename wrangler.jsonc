// Cloudflare deploy config for foddersports.com.
// The site is static files; the small Worker only handles /ingest/*, which forwards
// analytics to PostHog from our own domain so ad blockers don't drop visitor data.
{
  "name": "fodder-sports",
  "main": "worker.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/ingest/*"]
  }
}
